# Proofly Backend Configuration Environment Template
PORT=8000
HOST=0.0.0.0
ENV=development

# Database Settings
# Use local MongoDB daemon or MongoDB Atlas URL. Fallback mock DB automatically engages if unavailable.
MONGODB_URI=mongodb://localhost:27017
DB_NAME=proofly_db

# Security & JWT Authentication
JWT_SECRET=proofly_jwt_super_secret_key_change_in_production_2026!
JWT_REFRESH_SECRET=proofly_jwt_refresh_super_secret_key_2026!
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Base URL
BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
